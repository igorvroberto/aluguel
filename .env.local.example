# Mapa (Maps JavaScript API) — obrigatório para ver o mapa
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Routes API (TRANSIT) — transporte público
# VPS: set in /opt/radar-imoveis/.env then rebuild se mudar NEXT_PUBLIC_*
GOOGLE_MAPS_API_KEY=

# Opcional — geocode (scrape/cadastro) e walk fallback
# https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=
