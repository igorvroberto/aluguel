# Copiar para .env na VPS (/opt/radar-imoveis/.env). Nunca commitar .env.
# Não reutilizar senhas/tokens do Chatwoot / imoveis além do necessário.

TZ=America/Sao_Paulo
COMPOSE_PROJECT_NAME=radar-imoveis

# Obrigatório para mapa, rotas a pé e geocoding (também usado no docker build)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Opcional — Google Routes API (TRANSIT). Sem isso, a UI usa estimativa local.
# Na VPS: coloque em /opt/radar-imoveis/.env e rode:
#   cd /opt/radar-imoveis && docker compose up -d web
GOOGLE_MAPS_API_KEY=
