# Copiar para .env na VPS (/opt/radar-imoveis/.env). Nunca commitar .env.
# Não reutilizar senhas/tokens do Chatwoot / imoveis além do necessário.

TZ=America/Sao_Paulo
COMPOSE_PROJECT_NAME=radar-imoveis

# Obrigatório — mesma chave: mapa (Maps JavaScript), Routes TRANSIT e Elevation.
# No Google Cloud Console: ative Maps JavaScript API + Routes API + Elevation API,
# faturamento ligado; referrer HTTP para o domínio do radar (e IP/sem restrição p/ server).
GOOGLE_MAPS_API_KEY=

# Opcional — embute a chave no build do cliente (senão o app busca em /api/maps-config)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Opcional — geocode no scrape / cadastro e trechos a pé no fallback
NEXT_PUBLIC_MAPBOX_TOKEN=

# Opcional — Playwright headless como fallback do scrape (pesado; off na VPS 512MB)
ENABLE_PLAYWRIGHT_SCRAPE=0
